# Cloudflare Images / R2 CDN (optional). Leave empty to serve git-backed /public/images.
# Example: https://images.terraskyeview.com
NEXT_PUBLIC_MEDIA_BASE=

# Google Search Console HTML-tag verification.
# Paste only the content value from the meta tag Google gives you, not the full HTML.
# Set this on Vercel (Production + Preview), redeploy, then click Verify in Search Console.
# Domain-property DNS verification does not need this variable.
GOOGLE_SITE_VERIFICATION=

# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# Optional: for rate limiting
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_rest_token
